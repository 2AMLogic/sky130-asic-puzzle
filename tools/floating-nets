#!/usr/bin/env python3
"""Count floating nets in a gate-level Verilog netlist (issue #68).

    tools/floating-nets <netlist.v> [--expect N]

A floating net is a net that is not a top-level port, feeds at least one
cell input pin, and is driven by no cell output pin. sky130_fd_sc_hd's driven
pins are X, Y, Q, HI and LO (`verilog_netlist.DRIVEN_PINS`, the one shared
definition); every other signal pin is an input. Fill cells are ignored.

Prints the count and exits 0 when it equals --expect (default 1), else 1.
Net names are printed only as counts of load pins, never layout content.
"""
from __future__ import annotations

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import verilog_netlist as vn  # noqa: E402


def floating(nl: vn.Netlist) -> dict[str, int]:
    ports = set(nl.port_names())
    driven: set[str] = set()
    loads: dict[str, int] = {}
    for inst in nl.instances:
        if vn.is_fill(inst.cell):
            continue
        for pin, net in inst.connections.items():
            if pin in vn.POWER_PINS:
                continue
            if pin in vn.DRIVEN_PINS:
                driven.add(net)
            else:
                loads[net] = loads.get(net, 0) + 1
    # `vn.POWER_NETS` (not POWER_PINS) is the right set for the last test: it
    # filters nets *named* like a supply rail, e.g. an input pin tied straight
    # to VGND, which no cell output drives and which is not floating either.
    return {
        n: c
        for n, c in loads.items()
        if n not in ports and n not in driven and n not in vn.POWER_NETS
    }


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("netlist")
    ap.add_argument("--expect", type=int, default=1)
    args = ap.parse_args()
    fl = floating(vn.load(args.netlist))
    print(f"floating nets in {args.netlist}: {len(fl)} (load pins: {sorted(fl.values())})")
    if len(fl) != args.expect:
        print(f"FAILED — expected exactly {args.expect} floating net(s).", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
