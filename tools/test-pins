#!/usr/bin/env python3
"""Self-test for `tools/gds_pins.py` (label-to-shape pin association).

Run with no arguments:  `tools/test-pins`

Six families of check:

* **Synthetic, well-formed** -- a tiny in-memory cell built with KLayout's
  own API (no file on disk) carrying one pin on each of the four label
  sources (`gds_layers.LABEL_SOURCES`), including the VNB case whose pin
  shape lives on a *different* GDS layer number (122) than its label (64) --
  the one case the association logic cannot get right by assuming "same
  layer number".
* **Synthetic, redundant label** -- a second label occurrence for the same
  pin name that does *not* land inside any `.pin` shape (observed for real
  on `sky130_fd_sc_hd__and2b_2`). Must still resolve from the occurrence
  that does, not raise and not silently drop the shape it did find.
* **Synthetic, coincident two-layer pin** -- a copy of A's pin box and
  label on met1, at the same coordinates as the li1 originals. Both views
  must agree the pin resolves to one polygon while each keeps its own
  layer report: the JSON view reports the last matching layer (68/16),
  the native view keeps the first occurrence of that geometry (layer 67).
  Feeding either deduplicated view into the other would lose information,
  so both views must consume the shared match list *before* either
  deduplicates (issue #164).
* **Synthetic, deliberately corrupted** -- a label with *no* containing
  `.pin` shape at all on any occurrence. Must raise `PinResolutionError`
  naming both the cell and the specific pin -- this is what proves the
  total-or-loud contract (issue #1) is enforced, not just documented.

The synthetic families exercise both public resolvers on the same cells:
`resolve_cell_pins` (the JSON view) and `resolve_cell_pin_shapes` (the
native view `tools/gds_extract.py` uses) share one label-to-shape search
(issue #164), so each synthetic check that pins behavior on one view has a
twin on the other.

* **Real-file smoke test** -- `tools/pins` against every `sky130_fd_sc_hd`
  cell used by `puzzle/warmup/04_final.gds` and `puzzle/puzzle.gds`, asserting
  zero unresolved pins (issue #1's acceptance criterion). SKIPPED, loudly,
  when `puzzle/` is absent.
* **CLI GDS-open failure paths** -- `tools/pins` against a nonexistent path
  and against an existing non-GDS file: each must exit 2 with
  `tools/pins: no such file: ...` / `tools/pins: could not read ...`
  on stderr (the wording lives in `klayout_env.open_layout`, not in the
  CLI). Needs no `puzzle/` file, only an importable `klayout`.

All of the above are SKIPPED, loudly, if no interpreter with an importable
`klayout` module can be found.

Exit status: 0 if every check that ran passed, 1 otherwise.
"""

from __future__ import annotations

import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
sys.path.insert(0, HERE)

from testutil import SKIP, _box, _label, check_cli_open_failures, make_tracker, require_klayout, skip_all_no_klayout, summarize

PINS = os.path.join(HERE, "pins")
WARMUP_GDS = os.path.join(ROOT, "puzzle", "warmup", "04_final.gds")
PUZZLE_GDS = os.path.join(ROOT, "puzzle", "puzzle.gds")

results, record, check = make_tracker()


KLAYOUT_OK, db, KLAYOUT_SKIP_REASON = require_klayout()


# ---------------------------------------------------------------------------
# synthetic cell construction
# ---------------------------------------------------------------------------


def _well_formed_cell(name: str = "sky130_fd_sc_hd__synth_2"):
    layout = db.Layout()
    layout.dbu = 0.001
    cell = layout.create_cell(name)

    # signal pin A: li1.pin (67/16) + li1.label (67/5), point inside the box
    _box(cell, layout, 67, 16, 0, 0, 100, 100)
    _label(cell, layout, 67, 5, "A", 50, 50)

    # VPWR / VGND: met1.pin (68/16) + met1.label (68/5)
    _box(cell, layout, 68, 16, 0, 900, 100, 1000)
    _label(cell, layout, 68, 5, "VPWR", 50, 950)
    _box(cell, layout, 68, 16, 0, -100, 100, 0)
    _label(cell, layout, 68, 5, "VGND", 50, -50)

    # VPB: nwell.pin (64/16) + nwell.label (64/5)
    _box(cell, layout, 64, 16, 0, 900, 100, 1000)
    _label(cell, layout, 64, 5, "VPB", 50, 950)

    # VNB: label sits at layer 64 (datatype 59), pin shape at layer 122 --
    # the case that would break a "same layer number" shortcut.
    _box(cell, layout, 122, 16, 0, -100, 100, 0)
    _label(cell, layout, 64, 59, "VNB", 50, -50)

    return layout, cell


def test_well_formed() -> None:
    import gds_pins

    layout, cell = _well_formed_cell()
    result = gds_pins.resolve_cell_pins(layout, cell)
    check(
        "well-formed: all five pins resolved",
        set(result.pins) == {"A", "VPWR", "VGND", "VPB", "VNB"},
        str(sorted(result.pins)),
    )
    check("well-formed: A on layer 67/16", result.pins["A"].layer == (67, 16))
    check(
        "well-formed: VNB resolves to layer 122 (not its label's layer 64)",
        result.pins["VNB"].layer == (122, 16),
        str(result.pins.get("VNB")),
    )
    a_poly = result.pins["A"].polygons
    check(
        "well-formed: A's polygon matches the drawn pin box (in microns)",
        a_poly == (((0.0, 0.0), (0.0, 0.1), (0.1, 0.1), (0.1, 0.0)),),
        str(a_poly),
    )

    shapes = gds_pins.resolve_cell_pin_shapes(layout, cell)
    check(
        "well-formed: native view resolves the same five pins",
        set(shapes) == set(result.pins),
        str(sorted(shapes)),
    )
    check(
        "well-formed: VNB native shapes live on layer 122 (not its label's 64)",
        bool(shapes.get("VNB")) and {layer for layer, _ in shapes["VNB"]} == {122},
        str(shapes.get("VNB")),
    )
    check(
        "well-formed: A's native shape is the drawn box in dbu units on layer 67",
        len(shapes.get("A", ())) == 1
        and shapes["A"][0][0] == 67
        and {(p.x, p.y) for p in shapes["A"][0][1].each_point_hull()}
        == {(0, 0), (0, 100), (100, 100), (100, 0)},
        str(shapes.get("A")),
    )


def test_redundant_label_occurrence() -> None:
    """A second label for the same pin, off in empty space (no containing
    shape) -- must not prevent resolution from the occurrence that does
    land inside a .pin shape (mirrors sky130_fd_sc_hd__and2b_2)."""
    import gds_pins

    layout, cell = _well_formed_cell()
    # A second "A" label far away from any shape.
    _label(cell, layout, 67, 5, "A", 5000, 5000)
    result = gds_pins.resolve_cell_pins(layout, cell)
    check(
        "redundant label: pin A still resolves to exactly one polygon",
        "A" in result.pins and len(result.pins["A"].polygons) == 1,
        str(result.pins.get("A")),
    )
    shapes = gds_pins.resolve_cell_pin_shapes(layout, cell)
    check(
        "redundant label: native view still resolves A to exactly one shape",
        len(shapes.get("A", ())) == 1,
        str(shapes.get("A")),
    )


def test_coincident_two_layer_pin() -> None:
    """A's pin box and label drawn twice -- on li1 (67) and on met1 (68),
    at the same coordinates (issue #164's example). The two views must
    agree that the pin resolves to one polygon, while each keeps its own
    layer report: the JSON view reports the last matching layer, the
    native view the first occurrence of that geometry. Feeding either
    deduplicated view into the other would lose information, so both must
    consume the match list before either deduplicates."""
    import gds_pins

    layout, cell = _well_formed_cell()
    # A copy of A's pin box and label on met1, same coordinates as the
    # li1 originals.
    _box(cell, layout, 68, 16, 0, 0, 100, 100)
    _label(cell, layout, 68, 5, "A", 50, 50)

    result = gds_pins.resolve_cell_pins(layout, cell)
    check(
        "coincident: JSON view resolves A to exactly one polygon",
        len(result.pins["A"].polygons) == 1,
        str(result.pins.get("A")),
    )
    check(
        "coincident: JSON view reports the last matching layer (68/16)",
        result.pins["A"].layer == (68, 16),
        str(result.pins.get("A")),
    )
    shapes = gds_pins.resolve_cell_pin_shapes(layout, cell)
    check(
        "coincident: native view resolves A to exactly one shape",
        len(shapes.get("A", ())) == 1,
        str(shapes.get("A")),
    )
    check(
        "coincident: native view keeps the first occurrence's layer (67)",
        shapes["A"][0][0] == 67,
        str(shapes.get("A")),
    )


def test_total_or_loud() -> None:
    """A label with *no* containing .pin shape anywhere must be a hard,
    localised error -- never a silently empty/skipped pin. Both views raise
    it (one resolution rule), naming the cell, the pin, and how many label
    occurrences were tried."""
    import gds_pins

    layout = db.Layout()
    layout.dbu = 0.001
    cell = layout.create_cell("sky130_fd_sc_hd__broken_2")
    # Label "A" exists twice, but no li1.pin (67/16) shape anywhere in the
    # cell.
    _label(cell, layout, 67, 5, "A", 50, 50)
    _label(cell, layout, 67, 5, "A", 5000, 5000)

    for view, resolver in (
        ("json", gds_pins.resolve_cell_pins),
        ("native", gds_pins.resolve_cell_pin_shapes),
    ):
        try:
            resolver(layout, cell)
        except gds_pins.PinResolutionError as exc:
            message = str(exc)
            check(f"total-or-loud: {view} view raises PinResolutionError", True)
            check(
                f"total-or-loud: {view} error names the cell",
                "sky130_fd_sc_hd__broken_2" in message,
                message,
            )
            check(f"total-or-loud: {view} error names the pin", "'A'" in message, message)
            check(
                f"total-or-loud: {view} error reports the occurrence count",
                "2 label occurrence(s)" in message,
                message,
            )
        else:
            check(f"total-or-loud: {view} view raises PinResolutionError", False, "no exception raised")


# ---------------------------------------------------------------------------
# real-file smoke test
# ---------------------------------------------------------------------------


def _run_pins(gds_path: str) -> tuple[int, str, str]:
    proc = subprocess.run(
        [sys.executable, PINS, gds_path, "--keep-going"],
        capture_output=True,
        text=True,
        timeout=300,
    )
    return proc.returncode, proc.stdout, proc.stderr


def _smoke_test(label: str, gds_path: str, expected_cells: int) -> None:
    if not os.path.isfile(gds_path):
        record(label, SKIP, f"{gds_path} missing -- run scripts/fetch-puzzle.sh")
        return
    code, stdout, stderr = _run_pins(gds_path)
    check(f"{label}: exit 0 (zero unresolved pins)", code == 0, stderr.strip()[:300])
    if code == 0:
        import json

        doc = json.loads(stdout)
        check(
            f"{label}: resolved {expected_cells} distinct library cells",
            len(doc["cells"]) == expected_cells,
            str(len(doc["cells"])),
        )
        total_pins = sum(len(c["pins"]) for c in doc["cells"].values())
        check(f"{label}: at least one pin per cell", total_pins >= expected_cells)


# ---------------------------------------------------------------------------
# CLI GDS-open failure paths (the preamble the CLI inherits from
# klayout_env.open_layout)
# ---------------------------------------------------------------------------


def test_cli_open_failures() -> None:
    """Both GDS-open failure branches: a nonexistent path, and an existing
    file that is not a GDS stream. Neither needs `puzzle/` fetched."""
    check_cli_open_failures(check, PINS, "tools/pins", "test-pins-open-fail-")


def main() -> int:
    print("tools/test-pins")
    print("=" * 60)

    if not KLAYOUT_OK:
        return skip_all_no_klayout(KLAYOUT_SKIP_REASON)

    print("\n1. Synthetic, well-formed cell (all four label sources, both views)")
    test_well_formed()

    print("\n2. Synthetic, redundant label occurrence (both views)")
    test_redundant_label_occurrence()

    print("\n3. Synthetic, coincident two-layer pin (both views)")
    test_coincident_two_layer_pin()

    print("\n4. Synthetic, deliberately corrupted (total-or-loud contract, both views)")
    test_total_or_loud()

    print("\n5. Real-file smoke test (warm-up, 18 cells)")
    _smoke_test("warmup", WARMUP_GDS, 18)

    print("\n6. Real-file smoke test (puzzle, 69 cells)")
    _smoke_test("puzzle", PUZZLE_GDS, 69)

    print("\n7. CLI GDS-open failure paths (no such file / could not read)")
    test_cli_open_failures()

    print("=" * 60)
    return summarize(results)


if __name__ == "__main__":
    sys.exit(main())
