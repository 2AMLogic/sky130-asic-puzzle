# Upstream puzzle files — janestreet/asic-puzzle-2026 carries no license, so
# they are fetched, never committed. See scripts/fetch-puzzle.sh.
puzzle/
*.gds
*.oas
*.vcd

# Extraction and simulation output. build/ holds netlists extracted from the
# upstream GDS — a derived representation of a file that carries no license, so
# it is not committed either (CLAUDE.md §3).
build/
*.spice
*.raw
*.vcd.gz
__pycache__/
*.pyc
.venv/
